   "source": [
    "#1\n",
    "n=int(input())\n",
    "m=int(input())\n",
    "l=[]\n",
    "\n",
    "for i in range(1,min(n,m)+1):\n",
    "    if n%i==0 and m%i==0:\n",
    "        l.append(i)\n",
    "\n",
    "print(l)\n"
   ]
